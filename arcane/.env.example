APP_URL=https://arcane.example.com
PUID=10001
PGID=65534
# 32-byte key (raw, base64, or hex) — generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
# Server clone path (must match the mounted path below); the folder must be
# reachable at the same absolute path inside and outside the container.
PROJECTS_DIRECTORY=/srv/stacks
