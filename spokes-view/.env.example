# spokes-view has no secrets: every value here is plain configuration. Copy to .env.
# The image already sets SPOKES_VIEW_BIND=0.0.0.0:8788.

# Host port published for the container's 8788 (compose default 10060). Host nginx
# proxies https://view.<domain> to it (map line generated from the compose default).
SPOKES_VIEW_PORT=10060

# The Spokes servers the page offers, as Name=URL pairs separated by commas, in picker order.
# Each must run Spokes 0.2.0 or later (the read-only /api). Use an address the container can
# reach: the server's LAN IP and the spokes stack's host port, not localhost.
# Names: letters, digits, spaces, '-', '_', '.'.
SPOKES_VIEW_SERVERS=Home=http://192.168.5.100:10050

# Optional: log level (error, warn, info, debug, trace). Default info.
# SPOKES_VIEW_LOG=info
