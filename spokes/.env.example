# Spokes has no secrets: every value here is plain configuration. Copy to .env.
# The image already sets SPOKES_BIND=0.0.0.0:8787 and SPOKES_DB_PATH=/data/spokes.db.

# IANA time zone that decides what "today" is for due dates, defer_until and recurrence.
SPOKES_TZ=America/Chicago

# Nightly in-container backups (SQLite VACUUM INTO). Unset SPOKES_BACKUP_DIR to turn them off.
SPOKES_BACKUP_DIR=/data/backups
# How many backup files to keep (oldest are deleted first).
SPOKES_BACKUP_KEEP=14

# Optional: hostnames /mcp answers to (comma-separated; a bare name matches any port), e.g. zcog.net,localhost.
# Unset accepts any Host.
# SPOKES_ALLOWED_HOSTS=

# Optional: browser origins allowed to call /mcp (comma-separated). Unset refuses any Origin header.
# SPOKES_ALLOWED_ORIGINS=

# Optional: log level (error, warn, info, debug, trace). Default info.
# SPOKES_LOG=info
