# Copy to .env on the server. Never commit the real file.

# Base URL of the norsworthy-monitor API (reached over the norsworthy-net network).
BASE_URL=http://norsworthy-monitor:3000

# Comma-separated container names (or id prefixes) that get a tile in the status image.
CONTAINER_WHITELIST=minecraft,valheim

# SECRET: the Discord webhook the status message is posted and edited through.
DISCORD_WEBHOOK_URL=changeme
