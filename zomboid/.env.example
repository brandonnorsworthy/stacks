# Project Zomboid dedicated server (danixu86/project-zomboid-dedicated-server)
# Empty values are ignored. Copy to .env and set real values.

# --- Identity / access -----------------------------------------------------
# Changing SERVERNAME creates a new world. No spaces or special characters.
SERVERNAME=projectviewpoint_vanilla
DISPLAYNAME=Project Viewpoint
PUBLIC=false
# Join password
PASSWORD=changeme
ADMINUSERNAME=admin
ADMINPASSWORD=changeme
STEAMVAC=true

# --- Networking (UDP). Production: 16261 / 16262 ---------------------------
PORT=16261
UDPPORT=16262

# --- Mods (Build 42 needs the backslash before each mod ID) ----------------
# ZombieBuddy 3619862853, Project Viewpoint 3809306528, 3D models 3810302175
WORKSHOP_IDS=3619862853;3809306528;3810302175
MOD_IDS=\ZombieBuddy;\Viewpoint;\PZVoxelStudioViewpoint

# --- Memory ----------------------------------------------------------------
MIN_MEMORY=2048m
MAX_MEMORY=8192m

# --- Game version ----------------------------------------------------------
# true = run steamcmd at start and move to the current public build. Needed once
# on a new install (data/pz-dedicated starts empty), then set to false: Project
# Viewpoint only works on the exact game build it was made for (42.22).
FORCEUPDATE=false

LANG=en_US.UTF-8
