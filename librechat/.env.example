# Shared LibreChat config (placeholders only; real values go in .env on the server)
# Generate with: openssl rand -hex 32 (CREDS_KEY, JWT_*, MEILI_MASTER_KEY) and openssl rand -hex 16 (CREDS_IV)
CREDS_KEY=changeme
CREDS_IV=changeme
JWT_SECRET=changeme
JWT_REFRESH_SECRET=changeme
MEILI_MASTER_KEY=changeme
SEARCH=true

# Public URL of LibreChat (used for links/cookies)
DOMAIN_CLIENT=http://localhost:10020
DOMAIN_SERVER=http://localhost:10020

# Registration: create your account once, then set ALLOW_REGISTRATION=false
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true

# Ollama base URL as seen from inside the container (also edit librechat.yaml)
OLLAMA_URL=http://host.docker.internal:11434
