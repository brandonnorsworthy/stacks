# Valheim dedicated server (lloesche/valheim-server)
# All names/values are CASE-SENSITIVE. See upstream README for the full list.

# --- Identity / access -----------------------------------------------------
SERVER_NAME=Valheim
WORLD_NAME=Dedicated
SERVER_PASS=changeme-min-5-chars
# Read the password from a secret file instead of the env above (leave both
# unset or SERVER_PASS_FILE set — file wins):
# SERVER_PASS_FILE=/run/secrets/server_pass
SERVER_PUBLIC=true
# Space-separated admin SteamID64s (overrides adminlist.txt):
# ADMINLIST_IDS=
# BANNEDLIST_IDS=
# PERMITTEDLIST_IDS=

# --- Networking ------------------------------------------------------------
# 2456 = game, 2457 = query, 2458 = crossplay RPC. Only 2458 is used when
# CROSSPLAY=true and/or a mod using RPC (gameport+2) is active.
SERVER_PORT=2456
CROSSPLAY=false

# --- Modding (pick at most ONE, or leave both false for vanilla) -----------
VALHEIM_PLUS=false
BEPINEX=false

# --- Scheduling ------------------------------------------------------------
UPDATE_CRON=*/15 * * * *
RESTART_CRON=10 5 * * *
BACKUPS=true
BACKUPS_CRON=5 * * * *
BACKUPS_MAX_AGE=7
BACKUPS_MAX_COUNT=10
BACKUPS_ZIP=true

# --- Housekeeping ----------------------------------------------------------
TZ=UTC
# Umask for created files/dirs (backups, config, worlds):
PERMISSIONS_UMASK=002

# --- Dedicated stack UID/GID (AGENTS.md). Entrypoint starts as root, then
# --- chowns /config and /opt/valheim to these, then drops privileges. -----
PUID=10002
PGID=65534
