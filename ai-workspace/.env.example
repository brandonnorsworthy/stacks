# GitHub access for the AI: a DEDICATED bot account's fine-grained PAT.
# Scope it to only the repos the AI should touch; grant Contents, Pull requests, Issues (read/write) and Metadata (read) at most.
# Give it an expiry and rotate it. Never reuse a personal token here.
GH_TOKEN=changeme

# Commit identity for the bot account
GIT_AUTHOR_NAME=changeme
GIT_AUTHOR_EMAIL=changeme@users.noreply.github.com
GIT_COMMITTER_NAME=changeme
GIT_COMMITTER_EMAIL=changeme@users.noreply.github.com

# Optional: skip interactive login for the agents (otherwise run `claude` / `opencode auth login`; logins persist in ./data/home)
# ANTHROPIC_API_KEY=
