# Secrets: the two role passwords set by db/bootstrap.sql in the landing repo.
# Generate each with `openssl rand -hex 24` (hex keeps the connection string simple).
# On the server this file is mode 640, owner brandon, group 65534 (Arcane reads it).
LANDING_MIGRATOR_PASSWORD=change-me
LANDING_APP_PASSWORD=change-me

# Host port for the site (compose default 10070). Host nginx proxies the bare domain (HTTPS, LAN only) to it.
LANDING_PORT=10070

# DNS server for the site's lookups (default 192.168.5.1, the LAN router). It must give LAN
# answers for local names, or bookmarks to them look down from the server.
# LANDING_DNS=192.168.5.1

# Seconds between status-check passes (default 60).
# LANDING_CHECK_INTERVAL=60
